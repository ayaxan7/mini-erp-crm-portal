<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Invoice <%= invoice.number %></title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #1f2937;
    font-size: 13px;
    padding: 40px 48px;
  }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; }
  .company h1 { font-size: 20px; letter-spacing: 0.5px; color: #111827; }
  .company p { line-height: 1.5; color: #4b5563; }
  .title-box { text-align: right; }
  .title-box h2 { font-size: 26px; letter-spacing: 3px; color: #2563eb; text-transform: uppercase; }
  .title-box .meta { margin-top: 10px; font-size: 12px; }
  .title-box .meta div { padding: 2px 0; }
  .title-box .meta .label { display: inline-block; width: 70px; color: #6b7280; }
  .title-box .meta .value { font-weight: 600; color: #111827; }
  .parties { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .box { border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; width: 48%; }
  .box .box-title { font-size: 11px; letter-spacing: 1.5px; color: #6b7280; text-transform: uppercase; margin-bottom: 8px; }
  .box p { line-height: 1.6; color: #111827; }
  .box .muted { color: #4b5563; }
  table.items { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
  table.items th {
    background: #2563eb; color: #fff; text-align: left;
    padding: 9px 10px; font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
  }
  table.items th.num, table.items td.num { text-align: right; }
  table.items td { padding: 9px 10px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  table.items td.sku { color: #6b7280; }
  table.items tr:nth-child(even) td { background: #f9fafb; }
  .totals { display: flex; justify-content: flex-end; margin-top: 8px; }
  .totals table { width: 280px; border-collapse: collapse; }
  .totals td { padding: 5px 10px; }
  .totals td.label { color: #6b7280; }
  .totals td.amount { text-align: right; font-weight: 600; }
  .totals tr.grand td { border-top: 2px solid #111827; font-size: 15px; font-weight: 700; color: #111827; }
  .footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e5e7eb; font-size: 11px; color: #6b7280; line-height: 1.6; }
  .remarks { margin-top: 16px; padding: 12px 14px; background: #f9fafb; border-radius: 6px; color: #4b5563; }
  .remarks .box-title { font-size: 11px; letter-spacing: 1.5px; color: #6b7280; text-transform: uppercase; margin-bottom: 6px; }
  .badge {
    display: inline-block; padding: 3px 10px; border-radius: 9999px;
    font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
  }
  .badge.confirmed { background: #d1fae5; color: #065f46; }
  .badge.draft { background: #fef3c7; color: #92400e; }
  .badge.cancelled { background: #fee2e2; color: #991b1b; }
</style>
</head>
<body>
  <div class="header">
    <div class="company">
      <h1><%= company.name %></h1>
      <p><%= company.address %></p>
      <p>Phone: <%= company.phone %> &nbsp;|&nbsp; Email: <%= company.email %></p>
      <p>GSTIN: <%= company.gst %></p>
    </div>
    <div class="title-box">
      <h2>Invoice</h2>
      <div class="meta">
        <div><span class="label">No.</span><span class="value"><%= invoice.number %></span></div>
        <div><span class="label">Date</span><span class="value"><%= invoice.date %></span></div>
        <div><span class="label">Status</span><span class="badge <%= invoice.status.toLowerCase() %>"><%= invoice.status %></span></div>
      </div>
    </div>
  </div>

  <div class="parties">
    <div class="box">
      <div class="box-title">Billed To</div>
      <p><strong><%= customer.businessName || customer.name %></strong></p>
      <p><%= customer.name %></p>
      <p class="muted"><%= customer.address || 'No address on file' %></p>
      <p class="muted">Mobile: <%= customer.mobile %></p>
      <% if (customer.email) { %><p class="muted">Email: <%= customer.email %></p><% } %>
      <% if (customer.gstNumber) { %><p class="muted">GSTIN: <%= customer.gstNumber %></p><% } %>
    </div>
    <div class="box">
      <div class="box-title">Shipping Address</div>
      <p><strong><%= customer.businessName || customer.name %></strong></p>
      <p class="muted"><%= customer.address || 'Same as billing address' %></p>
    </div>
  </div>

  <table class="items">
    <thead>
      <tr>
        <th style="width: 34px;">#</th>
        <th>Item</th>
        <th>SKU</th>
        <th class="num">Qty</th>
        <th class="num">Unit Price</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function (item, index) { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><strong><%= item.productName %></strong></td>
          <td class="sku"><%= item.productSku %></td>
          <td class="num"><%= item.quantity %></td>
          <td class="num"><%= Number(item.unitPrice).toFixed(2) %></td>
          <td class="num"><%= item.amount %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="totals">
    <table>
      <tr><td class="label">Total Quantity</td><td class="amount"><%= totals.totalQuantity %></td></tr>
      <tr><td class="label">Subtotal</td><td class="amount">INR <%= totals.subtotal %></td></tr>
      <tr><td class="label">GST (<%= totals.gstRate %>% on goods value)</td><td class="amount">INR <%= totals.tax %></td></tr>
      <tr class="grand"><td>Grand Total</td><td class="amount">INR <%= totals.total %></td></tr>
    </table>
  </div>

  <% if (invoice.remarks) { %>
    <div class="remarks">
      <div class="box-title">Remarks</div>
      <div><%= invoice.remarks %></div>
    </div>
  <% } %>

  <div class="footer">
    This is a computer-generated document and does not require a physical signature.
    Please retain a copy for your accounting records. Goods once sold will not be taken back.
  </div>
</body>
</html>
