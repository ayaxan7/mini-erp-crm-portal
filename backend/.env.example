# --- Server ----------------------------------------------------------------
# Port the API listens on
PORT=4000

# Production, development or test
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string to the main database
DATABASE_URL=postgres://localhost:5432/crm_dev

# (Optional) database used only by the automated test suite
TEST_DATABASE_URL=postgres://localhost:5432/crm_test

# --- Auth -------------------------------------------------------------------
# Strong random secret used to sign JWTs. NEVER commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime, format used by the jsonwebtoken library
JWT_EXPIRES_IN=8h

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (the deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173