# --- Server ----------------------------------------------------------------
# Port the API listens on
PORT=4000

# Production, development or test
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string to the main database
DATABASE_URL=postgres://localhost:5432/crm_dev

# (Optional) database used only by the automated test suite
TEST_DATABASE_URL=postgres://localhost:5432/crm_test

# --- Firebase Auth ---------------------------------------------------------
# The API verifies Firebase ID tokens with the Firebase Admin SDK.
# Configure as a local service-account JSON file:
FIREBASE_CREDENTIALS_PATH=.firebase/meridian-erp-firebase-adminsdk.json
# ...or as inline env vars (used on Render, never both):
# FIREBASE_PROJECT_ID=meridian-erp
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@meridian-erp.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (the deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173