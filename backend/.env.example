# --- Server ----------------------------------------------------------------
# Port the API listens on
PORT=4000

# Production, development or test
NODE_ENV=development

# --- Database --------------------------------------------------------------
# PostgreSQL connection string to the main database.
# Local example:    postgres://localhost:5432/crm_dev
# Neon (hosted) example — pooled endpoint, SSL required:
# DATABASE_URL=postgresql://neondb_owner:xxxxx@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true
DATABASE_URL=postgres://localhost:5432/crm_dev

# (Optional) database used only by the automated test suite
TEST_DATABASE_URL=postgres://localhost:5432/crm_test

# --- Auth -------------------------------------------------------------------
# Strong random secret used to sign JWTs. NEVER commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime, format used by the jsonwebtoken library
JWT_EXPIRES_IN=8h

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (the deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173

# --- Product images (optional) ----------------------------------------------
# Leave all four EMPTY to store uploaded product images on local disk under
# backend/uploads (served at /uploads). Set all four to upload to AWS S3 instead.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=my-crm-images

# --- Invoice PDF (optional) ---------------------------------------------------
# Path to a Chrome/Chromium binary used by puppeteer-core to render invoices to PDF.
# Only required when the invoice.pdf endpoint is used. In the production Docker
# image this is set automatically (/usr/bin/chromium).
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome